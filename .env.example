# Anthropic configuration
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Convex configuration
VITE_CONVEX_URL=your-convex-deployment-url-here

# Sentry configuration
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# RankGPT webhook (/api/rankgpt-webhook)
# Set this in your hosting env AND in Convex: npx convex env set RANKGPT_WEBHOOK_SECRET <value>
RANKGPT_WEBHOOK_SECRET=your-rankgpt-webhook-secret-here
# Public site origin used in the link returned to RankGPT (defaults to Netlify's URL)
SITE_URL=https://laphonefix.com

#Important! Never commit your `.env` file to version control as it contains sensitive information.